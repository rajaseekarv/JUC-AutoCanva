DATABASE_URL="postgresql://adflow:adflow@localhost:5432/adflow?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=3000
API_HOST="127.0.0.1"
WEB_ORIGIN="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:3000/api/v1"
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ACCESS_TTL_SECONDS=900
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD=""
SEED_BRANCH_USER_EMAIL="branch@example.local"
SEED_BRANCH_USER_PASSWORD=""
# Optional absolute or repository-root-relative local asset storage path
ASSET_STORAGE_DIR=.local-storage/assets
# Canva provider: "mock" (default) or "canva". Real mode fails closed unless
# CANVA_OAUTH_PERSISTENCE_ENABLED=true; see docs/integrations/canva.md.
# Never commit real values. Supply secrets from a secret manager or an
# untracked local .env.
CANVA_PROVIDER_MODE="mock"
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
# Local example: http://127.0.0.1:3000/api/v1/integrations/canva/oauth/callback
CANVA_REDIRECT_URI=""
# Comma-separated allowed origins for CANVA_REDIRECT_URI, e.g.
# https://api.example.com. Required for any https host; unset allows only
# http://127.0.0.1 and http://[::1] (local development).
CANVA_REDIRECT_ALLOWED_ORIGINS=""
# 32 random bytes, base64-encoded; separate from the client secret.
CANVA_TOKEN_ENCRYPTION_KEY=""
CANVA_TOKEN_ENCRYPTION_KEY_VERSION=1
# Optional, for key rotation: comma-separated version:base64-key pairs.
CANVA_TOKEN_ENCRYPTION_PREVIOUS_KEYS=""
# "true" or "false" only. Durable OAuth storage (requires the Canva OAuth
# migrations). Keep "false" until the PostgreSQL gates pass.
CANVA_OAUTH_PERSISTENCE_ENABLED="false"
# "true" or "false" only. Lets the revocation worker call Canva's revoke
# endpoint when triggered or from `canva:ops run-once --execute`. Requires
# CANVA_OAUTH_PERSISTENCE_ENABLED=true.
CANVA_REVOCATION_WORKER_ENABLED="false"
# PostgreSQL gates only (never in a deployment): the `pg` Vitest project
# exists only with ADFLOW_PG_TEST_URL set and ADFLOW_PG_GATES=run; gate F's
# Prisma CLI part also needs ADFLOW_PG_MIGRATE_RUNNER=run. See
# docs/integrations/canva.md.
