{
  "name": "adflow",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @adflow/web --filter @adflow/api dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check README.md \"apps/**/*.{md,json,ts,tsx,js,css,html}\" \"packages/shared-types/**/*.{json,ts}\" package.json pnpm-workspace.yaml eslint.config.js .prettierrc.json",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:api-tests": "pnpm --filter @adflow/api typecheck:test",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "prisma": "^6.0.0",
    "@prisma/client": "^6.0.0"
  },
  "type": "module",
  "prisma": {
    "seed": "node ./apps/api/node_modules/ts-node/dist/bin.js --project ./apps/api/tsconfig.json ./apps/api/prisma/seed.ts"
  }
}
